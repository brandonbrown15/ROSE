{
  "name": "rose-worker",
  "version": "0.1.0",
  "private": true,
  "description": "ROSE Core — Cloudflare Worker backend (chat, memory, recall) for the ROSE persistent AI assistant.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply rose-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply rose-db --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.0",
    "typescript": "^5.5.0",
    "wrangler": "^4.0.0"
  }
}
