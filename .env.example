# Copy this file to .env and fill in your own values.
# Never commit .env — it is already covered by .gitignore.
#
# These variables are used by scripts/setup.sh and scripts/deploy.sh for local
# development. In production, the Worker reads its secrets from Cloudflare
# Worker Secrets (see docs/cloudflare.md), not from this file.

# --- OpenAI ---------------------------------------------------------------
# Used by the Cloudflare Worker to generate chat completions and embeddings.
OPENAI_API_KEY=

# --- ROSE -------------------------------------------------------------------
# Shared secret between the Home Assistant integration and the Worker.
# Generate one with: openssl rand -hex 32
ROSE_API_KEY=

# --- Home Assistant ---------------------------------------------------------
# Only needed if the Worker calls back into Home Assistant (e.g. to read
# entity state or call services on ROSE's behalf).
HA_URL=
HA_TOKEN=

# --- Cloudflare (deployment only, e.g. GitHub Actions / wrangler CLI) -------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
