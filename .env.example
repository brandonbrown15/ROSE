# Copy this file to .env and fill in your own values.
# Never commit .env — it is already covered by .gitignore.
#
# These variables are used by scripts/setup.sh and scripts/deploy.sh for local
# development. In production, the Worker reads its secrets from Cloudflare
# Worker Secrets (see docs/cloudflare.md), not from this file.

# --- OpenAI ---------------------------------------------------------------
# Used by the Cloudflare Worker to generate chat completions and embeddings.
OPENAI_API_KEY=

# --- ROSE -------------------------------------------------------------------
# Shared secret between the Home Assistant integration and the Worker.
# Leave this blank — scripts/setup.sh generates one for you automatically.
ROSE_API_KEY=

# --- Home Assistant ---------------------------------------------------------
# Only needed if the Worker calls back into Home Assistant (e.g. to read
# entity state or call services on ROSE's behalf) — including energy
# optimization below. Must be a URL reachable from the internet (a local
# homeassistant.local address won't work) — see docs/energy.md.
HA_URL=
HA_TOKEN=

# --- Cloudflare (deployment only, e.g. GitHub Actions / wrangler CLI) -------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Energy optimization (optional, off by default) -------------------------
# Heat pump scheduling against Octopus Agile prices + Met Office forecasts,
# plus optional SolarEdge solar/EV add-ons. See docs/energy.md and
# docs/billing.md before enabling.
ENERGY_OPTIMIZATION_ENABLED=

# Heat pump — MET_OFFICE_API_KEY is Brandon's own developer account (shared
# across every household); everything else that used to live here (Octopus
# region, forecast lat/long, heat pump entity ids, min/max temp) is now
# per-household config in D1, not a Worker secret — see docs/households.md
# and docs/billing.md. scripts/setup.sh writes the bootstrap 'default'
# household's values straight into D1 for you; every household added since
# multi-tenancy sets its own via POST /integrator/households/:id/energy.
MET_OFFICE_API_KEY=
OCTOPUS_PRODUCT_CODE=

# Solar (SolarEdge) — not installed yet? Leave blank, add these later. Still
# global/single-tenant (not sold as a billed add-on yet) — see docs/energy.md.
SOLAREDGE_API_KEY=
SOLAREDGE_SITE_ID=

# EV charging — needs solar configured too; controlled via Home Assistant,
# not SolarEdge directly (see docs/energy.md for why).
ROSE_EV_CHARGER_ENTITY_ID=
ROSE_EV_CHARGER_START_SERVICE=
ROSE_EV_CHARGER_STOP_SERVICE=
ROSE_EV_CHARGER_SURPLUS_THRESHOLD_KW=
